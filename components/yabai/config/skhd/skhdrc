# 由 MacKit 生成：请在 MacKit App「窗口」页或 hotkeys.json 修改，改这里会被覆盖。

# 上半屏第 1 格
ctrl + shift - y : $HOME/.config/yabai/scripts/window/position.sh grid top 1
# 上半屏第 2 格
ctrl + shift - u : $HOME/.config/yabai/scripts/window/position.sh grid top 2
# 上半屏第 3 格
ctrl + shift - i : $HOME/.config/yabai/scripts/window/position.sh grid top 3
# 上半屏第 4 格
ctrl + shift - o : $HOME/.config/yabai/scripts/window/position.sh grid top 4
# 下半屏第 1 格
ctrl + shift - h : $HOME/.config/yabai/scripts/window/position.sh grid bottom 1
# 下半屏第 2 格
ctrl + shift - j : $HOME/.config/yabai/scripts/window/position.sh grid bottom 2
# 下半屏第 3 格
ctrl + shift - k : $HOME/.config/yabai/scripts/window/position.sh grid bottom 3
# 下半屏第 4 格
ctrl + shift - l : $HOME/.config/yabai/scripts/window/position.sh grid bottom 4
# 左半屏
ctrl + shift - g : $HOME/.config/yabai/scripts/window/position.sh left
# 右半屏
ctrl + shift - 0x29 : $HOME/.config/yabai/scripts/window/position.sh right
# 全屏
ctrl + shift - space : $HOME/.config/yabai/scripts/window/position.sh full
# Finder：在当前目录打开终端
cmd + ctrl + shift - t : $HOME/.config/yabai/scripts/actions/finder-terminal.sh
# Music 播放/暂停
cmd + ctrl + shift - 0x29 : $HOME/.config/yabai/scripts/actions/music.sh toggle
# Music 下一首
cmd + ctrl + shift - 0x27 : $HOME/.config/yabai/scripts/actions/music.sh next
# 打开系统设置
cmd + alt - 0x2B : /usr/bin/open -b com.apple.systempreferences
# 合盖休眠开关
cmd + ctrl + alt - l : $HOME/.config/yabai/scripts/actions/local.sh lid-sleep
# 软件更新
cmd + ctrl + alt - b : $HOME/.config/yabai/scripts/actions/local.sh brew-maintain
# 全仓推送
cmd + ctrl + alt - p : $HOME/.config/yabai/scripts/actions/local.sh smart-push
# 启停 yabai
cmd + ctrl + shift - y : $HOME/.config/yabai/scripts/actions/yabai-service.sh
# 鼠标跟焦开关
cmd + ctrl + shift - m : $HOME/.config/yabai/scripts/actions/mouse-follows-focus.sh
# 剪贴板包成代码块粘贴
cmd + shift - v : $HOME/.config/yabai/scripts/actions/code-fence-paste.sh
