# MacKit shell entry: plugins -> options/actions -> private additions -> keys.
# MACKIT_ROOT is set by the installer-generated ~/.zshrc.
# A terminal started from inside a Claude Code session (`open` hands the app the
# caller's environment) passes that session's markers to every tab: Claude then
# runs as a child session and saves no transcript, and git gets a no-op editor.
# Keep them only when a Claude process really is an ancestor of this shell.
if [[ -n ${CLAUDECODE-}${CLAUDE_CODE_CHILD_SESSION-} ]]; then
  () {
    local pid=$PPID ppid comm
    while (( pid > 1 )); do
      (( pid == ${CLAUDE_PID:-0} )) && return
      read -r ppid comm <<<"$(ps -o ppid=,comm= -p $pid 2>/dev/null)"
      [[ ${comm:t} == claude ]] && return
      pid=${ppid:-0}
    done
    unset CLAUDECODE CLAUDE_PID AI_AGENT NoDefaultCurrentDirectoryInExePath COREPACK_ENABLE_AUTO_PIN \
      CLAUDE_CODE_{CHILD_SESSION,ENTRYPOINT,EXECPATH,SESSION_ID,SESSION_ATTENDED,MESSAGING_SOCKET,MESSAGING_TOKEN}
    [[ ${GIT_EDITOR-} == true ]] && unset GIT_EDITOR
  }
fi
typeset -g MACKIT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mackit"
typeset -g MACKIT_PROFILE="${MACKIT_PROFILE:-developer}"
[[ -r "$MACKIT_CONFIG/profile.zsh" ]] && source "$MACKIT_CONFIG/profile.zsh"
if [[ -r "${ZIM_HOME:-$HOME/.zim}/init.zsh" ]]; then
  source "${ZIM_HOME:-$HOME/.zim}/init.zsh"
else
  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
  autoload -Uz compinit
  compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/mackit-zcompdump"
fi
source "$MACKIT_ROOT/components/zsh/options.zsh"
source "$MACKIT_ROOT/components/zsh/actions.zsh"
for file in "$MACKIT_ROOT"/components/zsh/functions/*.zsh(N); do source "$file"; done
[[ -r "$MACKIT_CONFIG/local.zsh" ]] && source "$MACKIT_CONFIG/local.zsh"
source "$MACKIT_ROOT/components/zsh/aliases.zsh"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[atuin] )) && eval "$(atuin init zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"
source "$MACKIT_ROOT/components/zsh/keymaps.zsh"
[[ -r "$MACKIT_CONFIG/keymaps.zsh" ]] && source "$MACKIT_CONFIG/keymaps.zsh"
if [[ -n "$GHOSTTY_RESOURCES_DIR" && -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
 source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi
